# ==========================================
# 🛡️ LogicHive: Configuration Template
# ==========================================
# Rename this file to .env and fill in the values.
# Local-First Strategy: Default is optimized for Ollama + FastEmbed (Offline).

# --- 1. Provider Selection ---
# Choose your AI and Embedding providers.
# Options for LLM: ollama, gemini
MODEL_TYPE=ollama
# Options for Embedding: fastembed, gemini
EMBEDDING_PROVIDER=fastembed

# --- 2. Local-First Configuration (Recommended) ---
# For Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral-large
# For Local Embedding (FastEmbed)
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# --- 3. Cloud-Hybrid Options (Optional: For High Precision) ---
# Get your Gemini API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Formal Gemini Model Name (e.g., models/gemma-4-31b-it)
GEMINI_MODEL=models/gemma-4-31b-it
# Formal Gemini Embedding Name (e.g., models/gemini-embedding-2)
EMBEDDING_MODEL_ID=models/gemini-embedding-2

# --- 4. Server Settings ---
# Port the MCP server will listen on
PORT=10880
# Host address (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# --- 5. Quality Gate ---
# Minimum score (0-100) for logic to be accepted into the hub
QUALITY_GATE_THRESHOLD=70
