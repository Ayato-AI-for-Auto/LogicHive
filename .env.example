# ==========================================
# 🛡️ LogicHive: Configuration Template
# ==========================================
# Rename this file to .env and fill in the values.
# If running as .exe, place the .env file in the same directory as the .exe.

# --- 1. AI & Models (Primary) ---
# Your Google Gemini API Key (Required if MODEL_TYPE=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use: "gemini" or "ollama"
MODEL_TYPE=gemini

# Specific Gemini Model ID
# Recommended: models/gemma-3-27b-it, gemini-2.0-flash-exp, etc.
GEMINI_MODEL=models/gemma-3-27b-it

# Embedding Model for Vector Search
EMBEDDING_MODEL_ID=gemini-embedding-001

# --- 2. Ollama Configuration (Optional) ---
# Set these if you use MODEL_TYPE=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral-large-3:675b-cloud

# --- 3. Server Settings ---
# Port the MCP server will listen on
PORT=10880
# Host address (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# --- 4. Quality Gate & Security ---
# Minimum score (0-100) for logic to be accepted into the hub
QUALITY_GATE_THRESHOLD=70

# --- 5. Advanced / System ---
# Set to "true" to enable automatic versioned backups to GitHub
ENABLE_AUTO_BACKUP=false
GITHUB_TOKEN=your_github_token_for_backup
