# ==========================================
# 🛡️ LogicHive: Configuration Template
# ==========================================
# Rename this file to .env and fill in the values.
# Local-First Strategy: Default is optimized for Ollama + Fastembed (Offline).

# --- 1. Provider Selection ---
# Options: ollama (Local-First), gemini (Cloud-Hybrid)
MODEL_TYPE=ollama
# Options: fastembed (Local-Fast), gemini (Cloud-HighPrecision)
EMBEDDING_PROVIDER=fastembed

# --- 2. Local Configuration (Recommended for Privacy) ---
# Install Ollama at: https://ollama.com
OLLAMA_URL=http://localhost:11434
# Recommended Models: models/gemma-3-27b-it, llama3, qwen2.5-coder
OLLAMA_MODEL=mistral-large
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- 3. Gemini Settings (Optional: For "Forensic Auditor" precision) ---
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Formal Model Name (e.g., models/gemma-4-31b-it, gemini-2.0-flash-exp)
GEMINI_MODEL=models/gemma-4-31b-it
# Formal Embedding Name (e.g., models/gemini-embedding-2)
EMBEDDING_MODEL_ID=models/gemini-embedding-2

# --- 4. Server Settings ---
PORT=10880
HOST=0.0.0.0

# --- 5. LogicHive Quality Gate ---
# Minimum score (0-100) for logic to be accepted into the hub
QUALITY_GATE_THRESHOLD=70
